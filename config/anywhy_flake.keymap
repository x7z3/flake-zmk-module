#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_f_keys {
            bindings = <&mo 3>;
            key-positions = <39 42>;
        };

        win_mode {
            bindings = <&sl 4>;
            key-positions = <37 38>;
        };

        mac_mode {
            bindings = <&sl 0>;
            key-positions = <43 44>;
        };

        l_studio {
            bindings = <&studio_or_reset 0 0>;
            key-positions = <0 5 39>;
        };

        r_studio {
            bindings = <&studio_or_reset 0 0>;
            key-positions = <6 11 42>;
        };
    };

    macros {
        bt_clr_0: bt_clr_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLR_0";
        };

        bt_clr_1: bt_clr_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLR_1";
        };

        bt_clr_2: bt_clr_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLR_2";
        };

        bt_clr_3: bt_clr_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLR_3";
        };

        bt_clr_4: bt_clr_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLR_4";
        };
    };

    behaviors {
        bt0: bt0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT0";
            bindings = <&bt BT_SEL 0>, <&bt_clr_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt1: bt1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT1";
            bindings = <&bt BT_SEL 1>, <&bt_clr_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt2: bt2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT2";
            bindings = <&bt BT_SEL 2>, <&bt_clr_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt3: bt3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT3";
            bindings = <&bt BT_SEL 3>, <&bt_clr_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt4: bt4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT4";
            bindings = <&bt BT_SEL 4>, <&bt_clr_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        studio_or_reset: studio_or_reset {
            compatible = "zmk,behavior-hold-tap";
            label = "STUDIO_OR_RESET";
            bindings = <&sys_reset>, <&studio_unlock>;

            #binding-cells = <2>;
            tapping-term-ms = <10000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESCAPE      &kp Q     &kp W     &kp E      &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSPC
&kp TAB         &kp A     &kp S     &kp D      &kp F  &kp G        &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp APOS
&kp LEFT_SHIFT  &kp Z     &kp X     &kp C      &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp RIGHT_SHIFT
                &kp LALT  &kp LGUI  &kp LCTRL  &mo 1  &kp SPACE    &kp SPACE  &mo 2  &kp RCTRL  &kp RGUI  &kp RALT
            >;
        };

        fn {
            bindings = <
&trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp END       &kp HOME         &kp RET      &kp PAGE_DOWN  &kp PG_UP   &kp INSERT    &kp RETURN    &kp C_PLAY_PAUSE  &kp C_PREV
&kp CAPSLOCK  &kp LEFT_ALT          &kp LCTRL             &kp DELETE    &kp LGUI         &mkp RCLK    &kp LEFT       &kp DOWN    &kp UP_ARROW  &kp RIGHT     &kp SCROLLLOCK    &kp PRINTSCREEN
&trans        &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp LCLK    &kp C_NEXT     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans            &trans
              &trans                &trans                &trans        &none            &trans       &trans         &none       &trans        &trans        &trans
            >;
        };

        sym {
            bindings = <
&kp GRAVE  &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4       &kp N5        &kp NUMBER_6      &kp N7      &kp N8         &kp N9      &kp N0      &kp MINUS
&kp TILDE  &kp RS(NUMBER_1)  &kp RS(NUMBER_2)  &kp RS(NUMBER_3)  &kp RS(NUMBER_4)   &kp RS(N5)    &kp LS(NUMBER_6)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)  &kp LS(N0)  &kp UNDER
&trans     &kp LEFT_BRACE    &kp RIGHT_BRACE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans        &kp BACKSLASH     &kp EQUAL   &kp LS(EQUAL)  &trans      &trans      &sys_reset
           &trans            &trans            &trans            &none              &trans        &trans            &none       &trans         &trans      &trans
            >;
        };

        sys {
            bindings = <
&soft_off  &bt0    &bt1    &bt2    &bt3    &bt4      &bt_clr_0  &bt_clr_1  &bt_clr_2  &bt_clr_3  &bt_clr_4  &studio_unlock
&kp F12    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&trans     &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans     &trans     &trans     &trans
           &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans     &trans     &trans
            >;
        };

        win {
            bindings = <
&kp ESCAPE      &kp Q     &kp W     &kp E      &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSPC
&kp TAB         &kp A     &kp S     &kp D      &kp F  &kp G        &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp APOS
&kp LEFT_SHIFT  &kp Z     &kp X     &kp C      &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp RIGHT_SHIFT
                &kp LGUI  &kp LALT  &kp LCTRL  &mo 1  &kp SPACE    &kp SPACE  &mo 2  &kp RCTRL  &kp RALT  &kp RGUI
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
